# Database. Leave TURSO_DATABASE_URL unset to use the local file database (file:local.db).
# For Turso, set it to the libsql:// URL of the database and set TURSO_AUTH_TOKEN.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# First-run bootstrap only: accepted as the admin password while none is stored, ignored once
# the admin saves one. Leave empty and nobody can log in until a password is stored.
ADMIN_PASSWORD=
