{
  "model": "sonnet",
  "effortLevel": "medium",
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(**/*.pem)", "Read(**/*.key)"]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.js\""}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/route.sh\""}]}
    ]
  }
}
