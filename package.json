{
  "name": "official-business-form",
  "version": "1.0.0",
  "description": "Online Official Business Form with database storage and printable HTML generation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "echo 'Build completed'",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:import": "node scripts/import-data.js",
    "db:check": "node checks/run.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,json,css,html,md}": "prettier --write"
  }
}
